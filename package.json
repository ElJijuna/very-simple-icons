{
  "name": "very-simple-icons",
  "version": "1.0.0",
  "description": "Map npm package names to simple-icons icons",
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElJijuna/very-simple-icons.git"
  },
  "homepage": "https://github.com/ElJijuna/very-simple-icons#readme",
  "bugs": {
    "url": "https://github.com/ElJijuna/very-simple-icons/issues"
  },
  "keywords": [
    "icons",
    "simple-icons",
    "npm",
    "packages",
    "svg",
    "brand",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release"
  },
  "peerDependencies": {
    "simple-icons": ">=14"
  },
  "devDependencies": {
    "simple-icons": "^16",
    "typescript": "^5",
    "tsup": "^8",
    "vitest": "^2",
    "semantic-release": "^24",
    "@semantic-release/changelog": "^6",
    "@semantic-release/git": "^10",
    "@semantic-release/github": "^10",
    "@semantic-release/commit-analyzer": "^13",
    "@semantic-release/release-notes-generator": "^14",
    "@semantic-release/npm": "^12"
  }
}
